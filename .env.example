# Copy this file to .env and replace the placeholder values. Never commit .env.
#
# If your checkout lives under ~/Documents or ~/Desktop on macOS (iCloud's "Desktop & Documents"
# sync), point DATABASE_URL OUTSIDE that tree instead of the default below -- iCloud intermittently
# denies writes to freshly created files/directories there, which surfaces as "attempt to write a
# readonly database". See docs/assumptions.md. Example:
#   DATABASE_URL=sqlite:////Users/you/Library/Application Support/insurance-system/dev.db
# In production this is a Neon Postgres URL instead (postgres:// and postgresql:// are both
# rewritten automatically to the driver SQLAlchemy needs -- see backend/app/settings.py).
DATABASE_URL=sqlite:///./dev.db
POLICY_SIGNING_KEY=replace-with-output-of-python -c "import secrets; print(secrets.token_hex(32))"
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Shared broker token (see docs/assumptions.md for what a SHARED token does and doesn't prove).
# Only needed if you use the /broker routes. Generate one the same way as POLICY_SIGNING_KEY.
BROKER_API_TOKEN=replace-with-output-of-python -c "import secrets; print(secrets.token_hex(32))"
VERIFY_BASE_URL=http://localhost:5173/verify
MODEL_PATH=artifacts/models/ng_recommender_v1.joblib
# Comma-separated list of origins allowed to call this API (CORS). Locally the default
# (http://localhost:5173) is fine as-is; in production set it to your Vercel domain(s):
# FRONTEND_ORIGINS=https://cover-xyz.vercel.app,https://cover.example.com