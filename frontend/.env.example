# Copy this file to .env.production (or .env.local) and set the real value. Never commit .env*.
#
# Local dev: leave this unset. vite.config.js proxies /api/* to http://localhost:8000, so the
# browser only ever sees one origin and there's no CORS to think about.
#
# Production (Vercel): there's no dev proxy, so the built bundle must call the backend directly.
# Set this to your Render service's URL, WITHOUT a trailing slash or /api suffix -- client.js
# appends the path itself (e.g. VITE_API_BASE + "/quotes").
VITE_API_BASE=https://your-service.onrender.com
